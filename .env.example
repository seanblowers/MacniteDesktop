# Copy to .env and fill in. .env is git-ignored.
# Required only for signed + notarized release builds.

# The exact Common Name of your Developer ID Application certificate.
# Find yours: security find-identity -v -p codesigning
APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# Your Apple ID and an app-specific password (NOT your real password).
# Generate at appleid.apple.com → Sign-In and Security → App-Specific Passwords.
APPLE_ID="you@example.com"
APPLE_PASSWORD="abcd-efgh-ijkl-mnop"

# 10-character team ID from developer.apple.com → Membership.
APPLE_TEAM_ID="XXXXXXXXXX"
